# ── Google Search Console (required) ────────────────────────────────────────
# Full service-account JSON, as a single line. Locally you can instead set
# GSC_SERVICE_ACCOUNT_FILE to point at a credentials.json file on disk.
GSC_SERVICE_ACCOUNT_JSON=
GSC_SERVICE_ACCOUNT_FILE=credentials.json
GSC_SITE_URL=sc-domain:doyouneedahome.com

# ── Email delivery (optional — report still saved as a file + artifact) ────
EMAIL_PROVIDER=
REPORT_RECIPIENTS=

# SMTP provider
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# SendGrid provider
SENDGRID_API_KEY=
SENDGRID_FROM=

# Resend provider
RESEND_API_KEY=
RESEND_FROM=

# ── Optional lead-source integrations (unset = "not configured" in report) ─
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_FILE=
FUB_API_KEY=
LEAD_DOWNLOAD_SOURCE=
